    "import os\n",
    "import tarfile\n",
    "import urllib.request\n",
    "from pathlib import Path\n",
    "import pandas as pd\n",
    "from IPython.display import display\n",
    "\n",
    "def encontrar_raiz(marcadores=(\"01_limpeza\", \"dados\", \"data\", \"requirements.txt\")) -> Path:\n",
    "    atual = Path.cwd().resolve()\n",
    "    for candidato in [atual, *atual.parents]:\n",
    "        if any((candidato / m).exists() for m in marcadores):\n",
    "            return candidato\n",
    "    return atual\n",
    "\n",
    "RAIZ = encontrar_raiz()\n",
    "PASTA_DATA = RAIZ / \"data\"\n",
    "PASTA_DADOS = RAIZ / \"dados\"\n",
    "print(\"Raiz do projeto:\", RAIZ)\n",
    "\n",
    "URL_DADOS = \"https://ai2-semanticscholar-cord-19.s3-us-west-2.amazonaws.com/historical_releases/cord-19_2022-06-02.tar.gz\"\n",
    "\n",
    "if not PASTA_DATA.is_dir():\n",
    "    print(f\"Pasta 'data' não encontrada em {RAIZ}. Criando pasta e preparando dados...\")\n",
    "    PASTA_DATA.mkdir(parents=True, exist_ok=True)\n",
    "    \n",
    "    arquivo_tar = PASTA_DATA / \"cord-19_2022-06-02.tar.gz\"\n",
    "    tar_root = RAIZ / \"cord-19_2022-06-02.tar.gz\"\n",
    "    tar_parent = RAIZ.parent / \"cord-19_2022-06-02.tar.gz\"\n",
    "    \n",
    "    if tar_root.exists():\n",
    "        print(f\"Arquivo compactado já existente localizado em: {tar_root}\")\n",
    "        arquivo_tar = tar_root\n",
    "    elif tar_parent.exists():\n",
    "        print(f\"Arquivo compactado já existente localizado em: {tar_parent}\")\n",
    "        arquivo_tar = tar_parent\n",
    "    else:\n",
    "        print(f\"Iniciando download de {URL_DADOS} ...\")\n",
    "        def _progresso(blocos, tam_bloco, total):\n",
    "            if total > 0 and blocos % 10000 == 0:\n",
    "                baixado_mb = (blocos * tam_bloco) / (1024 * 1024)\n",
    "                total_mb = total / (1024 * 1024)\n",
    "                porcentagem = (blocos * tam_bloco * 100) / total\n",
    "                print(f\"\\rBaixando: {porcentagem:.1f}% ({baixado_mb:.1f} MB de {total_mb:.1f} MB)\", end=\"\")\n",
    "        urllib.request.urlretrieve(URL_DADOS, arquivo_tar, reporthook=_progresso)\n",
    "        print(\"\\nDownload concluído com sucesso!\")\n",
    "    \n",
    "    print(f\"Extraindo arquivos de {arquivo_tar.name} para {PASTA_DATA} ...\")\n",
    "    try:\n",
    "        with tarfile.open(arquivo_tar, \"r:gz\") as tar:\n",
    "            tar.extractall(path=PASTA_DATA, filter=\"data\")\n",
    "    except (TypeError, AttributeError):\n",
    "        with tarfile.open(arquivo_tar, \"r:gz\") as tar:\n",
    "            tar.extractall(path=PASTA_DATA)\n",
    "    print(\"Extração concluída!\")\n",
    "else:\n",
    "    print(f\"Pasta 'data' existente localizada em: {PASTA_DATA}\")"
   ]
  },
